# Copiar a backend/.env (git lo ignora) y ajustar. Nada de esto va en el código.

# Cosmos DB
COSMOS_ENDPOINT=https://bibliotecavirtual-cosmos.documents.azure.com:443/
COSMOS_DB=biblioteca
# Opcional. Vacío = se usa la sesión de `az login` (recomendado, sin llaves).
# Con llave, el endpoint /libros/{id}/pdf no funciona: la SAS necesita `az login`.
COSMOS_KEY=

# Blob Storage
STORAGE_ACCOUNT=bibliotecadigital
CONTENEDOR_PDF=libros-escaneados
CONTENEDOR_PORTADAS=portadas
# Minutos que dura el enlace temporal al PDF
SAS_MINUTOS=15

# Equipo de escaneo: bloque de IDs de cada integrante, igual que la pestaña `Bloques`
# de la hoja de registro. Formato: Nombre:desde-hasta, separados por punto y coma.
EQUIPO=Integrante 1:1-750;Integrante 2:751-1500;Integrante 3:1501-2250;Integrante 4:2251-3000
